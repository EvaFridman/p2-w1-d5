# Server-side: read at run time, not inlined into the browser bundle
API_URL=
REVALIDATE_SECRET=
NEXT_BUILD_SECRET=
REDIS_HOST=
REDIS_PORT=

# NEXT_PUBLIC_*: inlined into the browser bundle at build time
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_BASE_URL=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
# Browser-side environment name (build time); the server side reads SENTRY_ENVIRONMENT
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Build time only (source map upload): keep in CI secrets
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
