generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db { 
  provider = "postgresql"
}

model Districts {
  id        Int        @id @default(autoincrement())
  title     String     @db.VarChar(255)
  slug      String     @unique @db.VarChar(255)
  city      String     @db.VarChar(255)
  createdAt DateTime   @db.Timestamptz(6)
  updatedAt DateTime   @db.Timestamptz(6)
  listings  Listings[] @relation("district_relation")
}

enum UserRole { 
  agent
  moderator
  client

  @@map("enum_Users_role")
}

model Users {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(255)
  email          String          @unique @db.VarChar(255)
  phone          String          @unique @db.VarChar(20)
  role           UserRole        @default(client)
  createdAt      DateTime        @db.Timestamptz(6)
  updatedAt      DateTime        @db.Timestamptz(6)
  passwordHash   String          @default("") @db.VarChar(255)
  avatarFileName String?         @db.VarChar(255)
  favorites      Favorites[]     @relation("user_favorites")
  listings       Listings[]      @relation("agent_listings")
  viewings       Viewings[]      @relation("viewing_clients")
  savedSearches  SavedSearches[] @relation("user_saved_searches")

  @@index([role], map: "users_role_idx")
}

enum DealType {
  sale
  rent
}

enum PropertyType { 
  flat
  house
  room
  commercial
}

enum ListingStatus { 
  DRAFT       @map("draft")
  MODERATION  @map("moderation")
  PUBLISHED   @map("published")
  REJECTED    @map("rejected")
  UNPUBLISHED @map("unpublished")
}

model Listings {
  id              Int                        @id @default(autoincrement())
  agentId         Int
  districtId      Int
  title           String                     @db.VarChar(255)
  description     String?
  dealType        DealType
  propertyType    PropertyType
  price           Decimal                    @db.Decimal(12, 2)
  area            Decimal                    @db.Decimal(6, 2)
  rooms           Int?
  floor           Int?
  totalFloors     Int?
  address         String
  lat             Decimal                    @db.Decimal(9, 6)
  lng             Decimal                    @db.Decimal(9, 6)
  status          ListingStatus
  rejectionReason String?
  publishedAt     DateTime?                  @db.Timestamptz(6)
  createdAt       DateTime                   @db.Timestamptz(6)
  updatedAt       DateTime                   @db.Timestamptz(6)
  favorites       Favorites[]                @relation("listing_favorites")
  photos          ListingPhotos[]            @relation("photo_listings")                 
  agent           Users                      @relation("agent_listings", fields: [agentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  district        Districts                  @relation("district_relation", fields: [districtId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  viewings        Viewings[]                 @relation("viewing_listings")
  statusHistory   ListingStatusHistory[]

  @@index([agentId], map: "listings_agent_id_idx")
  @@index([districtId], map: "listings_district_id_idx")
  @@index([dealType, propertyType, price], map: "listings_filter_idx")
  @@index([lat, lng], map: "listings_lat_lng_idx")
  @@index([status], map: "listings_published_partial_idx", where: raw("(status = 'published')"))
}

model ListingPhotos {
  id          Int      @id @default(autoincrement())
  listingId   Int
  externalUrl String?  @default("") @db.VarChar(255)
  position    Int?
  isCover     Boolean?
  createdAt   DateTime @db.Timestamptz(6)
  updatedAt   DateTime @db.Timestamptz(6)
  fileName    String?  @db.VarChar(255)
  sizeBytes   Int?
  listing     Listings @relation("photo_listings", fields: [listingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([listingId], map: "listingPhotos_listingId_idx")
}

enum ViewingStatus { 
  CREATED          @map("created")
  PENDING_APPROVAL @map("pending approval")
  APPROVED         @map("approved")
  REJECTED         @map("rejected")
  CLOSED           @map("closed")
}

model Viewings {
  id             Int                  @id @default(autoincrement())
  listingId      Int?
  clientId       Int?
  clientName     String               @db.VarChar(255)
  clientPhone    String               @db.VarChar(20)
  clientEmail    String               @db.VarChar(255)
  preferredAt    DateTime             @db.Timestamptz(6)
  comment        String?
  status         ViewingStatus
  reminderSentAt DateTime?            @db.Timestamptz(6)
  notifiedAt     DateTime?            @db.Timestamptz(6)
  createdAt      DateTime             @db.Timestamptz(6)
  updatedAt      DateTime             @db.Timestamptz(6)
  listing        Listings?            @relation("viewing_listings", fields: [listingId], references: [id], onUpdate: NoAction)
  client         Users?               @relation("viewing_clients", fields: [clientId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([listingId], map: "viewings_listingId_idx")
  @@index([clientId], map: "viewings_clientId_idx")
}

model Favorites {
  id        Int      @id @default(autoincrement())
  userId    Int
  listingId Int
  note      String?
  addedAt   DateTime @db.Timestamptz(6)
  createdAt DateTime @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
  listing   Listings @relation("listing_favorites", fields: [listingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      Users    @relation("user_favorites", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([userId, listingId], map: "favorites_userId_listingId_unique_idx")
}

model SavedSearches {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique @db.VarChar(32)
  name      String   @db.VarChar(100)
  nameKey   String   @db.VarChar(100)
  query     String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  user      Users    @relation("user_saved_searches", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, nameKey], map: "saved_searches_userId_nameKey_unique_idx")
  @@unique([userId, query], map: "saved_searches_userId_query_unique_idx")
}

model ListingStatusHistory {
  id         Int           @id @default(autoincrement())
  listingId  Int
  agentId    Int
  fromStatus ListingStatus
  toStatus   ListingStatus
  createdAt  DateTime      @db.Timestamptz(6)

  listing    Listings      @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([listingId, createdAt])
}