NODE_ENV=
PORT=
REDIS_HOST=
REDIS_PORT=
RABBITMQ_URL=
CLIENT_URL=
PUBLIC_URL=
WEB_URL=
MAIL_TRANSPORT=
REVALIDATE_SECRET=
NEXT_BUILD_SECRET=
DATABASE_URL=
PAGE_SIZE_DEFAULT=
PAGE_SIZE_MAX=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TTL=
REFRESH_TTL=
LOG_LEVEL=
TEMPORAL_ADDRESS=

# Mail: MAIL_TRANSPORT=stream writes mail to the log, real sends through SMTP
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional: users and viewings created before this ISO date come from imported data, their mail
# is only written to the log; MAIL_ALLOWED_RECIPIENTS (comma-separated) are exempt
MAIL_LEGACY_BEFORE=
MAIL_ALLOWED_RECIPIENTS=

# Password for users created by `prisma db seed` (at least 8 characters)
SEED_PASSWORD=

# Optional: shadow database for `prisma migrate dev`
SHADOW_DATABASE_URL=

# Optional logging: LOGDY=true is set by the *:logdy npm scripts;
# LOG_PROCESS overrides the process name in logs (api, queue-worker, temporal-worker)
LOGDY=
LOG_PROCESS=
