# Values for docker-compose.yml. Copy to .env (not in git) and fill in.
# Service addresses (postgres, redis, rabbitmq, api, web) are set in docker-compose.yml.
# Passwords go inside connection URLs: use letters and digits only.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Public address of the site (browser-facing), e.g. http://localhost:3001
SITE_URL=
# Admin client origin allowed by CORS, e.g. http://localhost:5173
CLIENT_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TTL=
REFRESH_TTL=

# Shared by api and web: must be the same value for both
REVALIDATE_SECRET=
NEXT_BUILD_SECRET=

# stream (mail written to the worker log) or real (SMTP)
MAIL_TRANSPORT=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional: users and viewings created before this moment (ISO date, e.g. 2026-10-02T00:30:00Z)
# come from imported data; mail to them is only written to the log. MAIL_ALLOWED_RECIPIENTS
# (comma-separated) are exempt.
MAIL_LEGACY_BEFORE=
MAIL_ALLOWED_RECIPIENTS=

# Password for all users created by `prisma db seed` (at least 8 characters)
SEED_PASSWORD=

PAGE_SIZE_DEFAULT=
PAGE_SIZE_MAX=
LOG_LEVEL=

# Optional: Temporal server address (default host.docker.internal:7233, the host machine;
# temporal:7233 with deploy/docker-compose.server.yml)
TEMPORAL_ADDRESS=

# Production overlay, optional: server-side Sentry of web (empty turns it off) and its environment
# name (default production)
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Server overlay (deploy/docker-compose.server.yml): domain Caddy serves and gets a certificate for,
# e.g. realty-catalog.site
SITE_DOMAIN=

# Optional, dev setup: host ports (defaults 3000, 5433, 6380, 5673, 15673)
API_HOST_PORT=
POSTGRES_HOST_PORT=
REDIS_HOST_PORT=
RABBITMQ_HOST_PORT=
RABBITMQ_UI_HOST_PORT=

# Production overlay: tag of the api and web images, the commit hash (git rev-parse --short=7 HEAD)
IMAGE_TAG=
# Production overlay, optional: registry prefix of published images, e.g. ghcr.io/evafridman/
IMAGE_REGISTRY=
