# Managed by Ansible (deploy/ansible, role app). Edits on the server are overwritten on deploy.
{% for name, value in app_env.items() %}
{{ name }}={{ value }}
{% endfor %}

POSTGRES_PASSWORD={{ vault_postgres_password }}
RABBITMQ_PASSWORD={{ vault_rabbitmq_password }}
JWT_ACCESS_SECRET={{ vault_jwt_access_secret }}
JWT_REFRESH_SECRET={{ vault_jwt_refresh_secret }}
REVALIDATE_SECRET={{ vault_revalidate_secret }}
NEXT_BUILD_SECRET={{ vault_next_build_secret }}
SMTP_PASS='{{ vault_smtp_pass }}'
SENTRY_DSN='{{ vault_sentry_dsn }}'
MAIL_ALLOWED_RECIPIENTS={{ vault_mail_allowed_recipients | default('') }}
# Seeds skip a database that has users; the restored copy has them.
SEED_PASSWORD=
