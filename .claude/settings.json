{
  "permissions": {
    "ask": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(unlink:*)",
      "Bash(git rm:*)",
      "Bash(git clean:*)",
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm ci:*)",
      "Bash(npm add:*)",
      "Bash(yarn add:*)",
      "Bash(pnpm add:*)",
      "Bash(npx prisma migrate dev:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(npx prisma migrate deploy:*)",
      "Bash(npx prisma migrate resolve:*)",
      "Bash(npx prisma db push:*)",
      "Bash(npx prisma db execute:*)",
      "Bash(npx prisma db seed:*)",
      "Bash(prisma migrate dev:*)",
      "Bash(prisma migrate reset:*)",
      "Bash(prisma migrate deploy:*)",
      "Bash(prisma migrate resolve:*)",
      "Bash(prisma db push:*)",
      "Bash(prisma db execute:*)",
      "Bash(prisma db seed:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh"
          }
        ]
      }
    ]
  }
}
